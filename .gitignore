# Track the stable baseline pair; ignore generated map builds
*.w3x
*.w3m
__pycache__/
*.pyc
build/
*.tmp

!release/FFERPG_0.9.7.3-r16.w3x
!release/FFERPG_0.9.7.3-r16-1.29.w3x
release/*
!release/.gitkeep
# Inputs for release builds
!release/Forsaken/
release/Forsaken/*
!release/Forsaken/FFERPG_0.9.7.3-r16-ForsakenEN.w3x
!release/Forsaken/gear-slots-BS.json
!release/pairs/
release/pairs/*

# The map authors edit in World Editor
!editor/FFERPG-Editor-Master.w3x

/delete/

# Local diagnostic reports may contain player and system data.
/ReportedCrashes/
/tools/build-inputs/crash-analysis-deps/
/tools/build-inputs/crash-tools/
# Locally installed font binaries.
/tools/build-inputs/fonts/*.ttf

