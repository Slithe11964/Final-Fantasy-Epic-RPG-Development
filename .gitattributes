# Trigger sources are stored exactly as World Editor saves them (CRLF)
src/**/*.j -text
*.py text eol=lf
*.md text eol=lf
# Preserve vendored compiler libraries exactly, including their original whitespace.
tools/bin/*.j -text whitespace=-blank-at-eol,-blank-at-eof
tools/versions/**/*.j -text whitespace=-blank-at-eol,-blank-at-eof
*.bat text eol=crlf
