function config takes nothing returns nothing
    call SetMapName("TRIGSTR_38788")
    call SetMapDescription("TRIGSTR_38790")
    call SetPlayers(12)
    call SetTeams(12)
    call SetGamePlacement(MAP_PLACEMENT_TEAMS_TOGETHER)

    call DefineStartLocation(0, 28352.0, 3648.0)
    call DefineStartLocation(1, 28352.0, 3648.0)
