library TForsakenFreshLoad requires TForsakenSaveFreshObjects, TForsakenSaveTransport, TSaveSlots, TLoad, TShrine, TTitle, TJobLevels, TTitles
// Generated by tools/save_port.py from experiments/Forsaken/Forsaken-fresh-load.j (the Reforged save).
// Edit that file and regenerate; slot adapters and bounded runtime strings preserve the format.
globals
    hashtable FFL_Before=null
    integer array FFL_Phase
    string array FFL_Error
    string array FFL_FailureReason
    integer array FFL_CleanupAttempts
    boolean array FFL_RetryCheck
