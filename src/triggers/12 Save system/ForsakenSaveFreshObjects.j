library TForsakenSaveFreshObjects requires TForsakenSaveFreshPlan
// Generated by tools/save_port.py from experiments/Forsaken/Forsaken-save-fresh-objects.j (the Reforged save).
// Edit that file and regenerate; slot adapters and bounded runtime strings preserve the format.
// Attempt-owned allocation. References, progression and HasLoadedCode remain untouched.
globals
    integer array FFN_State
    string array FFN_Error
    unit array FFN_Unit
    integer array FFN_UnitRaw
    item array FFN_Item
    integer array FFN_ItemRaw
    item array FFN_Spacer
    integer array FFN_SpacerCount
    integer array FFN_Count
endglobals

function FFN_ClearRecords takes integer pid returns nothing
    local integer i=0
    loop
        exitwhen (i >= 3)
        set FFN_Unit[pid*3+i]=null
        set FFN_UnitRaw[pid*3+i]=0
        set i=(i + 1)
    endloop
    set i=0
    loop
        exitwhen (i >= 57)
        set FFN_Item[pid*57+i]=null
        set FFN_ItemRaw[pid*57+i]=0
        set i=(i + 1)
    endloop
    set FFN_Count[pid]=0
endfunction

function FFN_CleanupSpacers takes integer pid returns boolean
    local integer i=0
    local integer index
    local boolean clean=true
    loop
        exitwhen (i >= FFN_SpacerCount[pid])
        set index=((pid * 36) + i)
        if (FFN_Spacer[index] != null) then
            call RemoveItem(FFN_Spacer[index])
            if (GetItemTypeId(FFN_Spacer[index]) == 0) then
                set FFN_Spacer[index]=null
            else
                set clean=false
            endif
        endif
        set i=(i + 1)
    endloop
    if clean then
        set FFN_SpacerCount[pid]=0
    endif
    return clean
endfunction

function FFN_Cleanup takes integer pid returns boolean
    local integer i=0
    local integer index
    local integer position
    local unit candidate
    local boolean clean=true
    local boolean occupied
    if (not FSC_PlayerValid(pid)) then
        return false
    elseif (FFN_State[pid] == 0) then
        return (not FFP_Locked[pid])
    endif
    set FFN_State[pid]=3
    set clean=FFN_CleanupSpacers(pid)
    loop
        exitwhen (i >= FFN_Count[pid])
        set index=((pid * 57) + i)
        if (FFN_Item[index] != null) then
            call RemoveItem(FFN_Item[index])
            if (GetItemTypeId(FFN_Item[index]) == 0) then
                set FFN_Item[index]=null
                set FFN_ItemRaw[index]=0
            else
                set clean=false
            endif
        endif
        set i=(i + 1)
    endloop
    set i=0
    loop
        exitwhen (i >= 3)
        set index=((pid * 3) + i)
        set candidate=FFN_Unit[index]
        if (candidate != null) then
            // Do not remove a unit holding an untracked item introduced by gameplay.
            set occupied=false
            set position=0
            loop
                exitwhen (position >= 6)
                if (UnitItemInSlot(candidate,position) != null) then
                    set occupied=true
                endif
                set position=(position + 1)
            endloop
            if (i != 1) then
                set position=0
                loop
                    exitwhen (position >= 30)
                    if (SaveSlots_Bag(candidate,position) != null) then
                        set occupied=true
                    endif
                    set position=(position + 1)
                endloop
                set position=0
                loop
                    exitwhen (position >= 9)
                    if (SaveSlots_Equip(candidate,position) != null) then
                        set occupied=true
                    endif
                    set position=(position + 1)
                endloop
            endif
            if (not occupied) then
                call RemoveUnit(candidate)
                if (GetUnitTypeId(candidate) == 0) then
                    set FFN_Unit[index]=null
                    set FFN_UnitRaw[index]=0
                else
                    set clean=false
                endif
            else
                set clean=false
            endif
        endif
        set i=(i + 1)
    endloop
    set candidate=null
    if (not clean) then
        set FFN_Error[pid]="cleanup incomplete; owned handles retained, retry blocked"
        return false
    endif
    call FFN_ClearRecords(pid)
    set FFN_State[pid]=0
    set FFP_Locked[pid]=false
    call FFP_Clear(pid)
    return true
endfunction

function FFN_Fail takes integer pid,string reason returns boolean
    set FFN_Error[pid]=reason
    if (not FFN_Cleanup(pid)) then
        set FFN_Error[pid]=FSS_Concat(reason,"; cleanup incomplete, retry blocked")
    endif
    return false
endfunction

function FFN_CreateUnit takes integer pid,integer slot,integer raw,unit origin returns boolean
    local integer index=((pid * 3) + slot)
    local unit created
    if (((not FSC_PlayerValid(pid)) or (slot < 0)) or (slot >= 3)) then
        return false
    elseif ((((FFN_State[pid] != 1) or (not FFP_Locked[pid])) or (raw == 0)) or (FFN_Unit[index] != null)) then
        return false
    endif
    set created=CreateUnit(Player(pid),raw,GetUnitX(origin),GetUnitY(origin),GetUnitFacing(origin))
    // Record immediately, including a malformed handle, before any readback or setup.
    set FFN_Unit[index]=created
    set FFN_UnitRaw[index]=raw
    if (((created == null) or (GetUnitTypeId(created) != raw)) or (GetOwningPlayer(created) != Player(pid))) then
        set created=null
        return false
    endif
    // 1.29.2 has no native to rename a hero, so it keeps its job name.
    set created=null
    return true
endfunction

function FFN_MetadataMatches takes integer pid,integer ordinal returns boolean
    local integer index=((pid * 57) + ordinal)
    local item carried=null
    local integer flags=0
    local integer binding=0
    if (((not FSC_PlayerValid(pid)) or (ordinal < 0)) or (ordinal >= FFN_Count[pid])) then
        return false
    endif
    set carried=FFN_Item[index]
    set flags=FFP_Flags[index]
    if FFP_Bound[index] then
        set binding=(pid + 1)
    endif
    if ((((((((carried == null) or (GetItemTypeId(carried) != FFN_ItemRaw[index])) or (GetItemPlayer(carried) != Player(pid))) or (GetItemCharges(carried) != FFP_Quantity[index])) or (GetItemUserData(carried) != binding)) or (IsItemInvulnerable(carried) != ((ModuloInteger(flags,2) == 1)))) or (IsItemPawnable(carried) != ((ModuloInteger((flags / 4),2) == 1)))) or (SaveSlots_CanDrop(carried) != ((ModuloInteger((flags / 2),2) == 1)))) then
        set carried=null
        return false
    endif
    if (((not FSL_Pack(pid,GetWidgetLife(carried))) or (FSL_High[pid] != FFP_High[index])) or (FSL_Low[pid] != FFP_Low[index])) then
        set carried=null
        return false
    endif
    set carried=null
    return true
endfunction

function FFN_CreateItem takes integer pid,integer ordinal returns boolean
    local integer index=((pid * 57) + ordinal)
    local integer flags=0
    local item carried
    local unit origin=null
    local integer binding=0
    if (((not FSC_PlayerValid(pid)) or (ordinal < 0)) or (ordinal >= FFP_Count[pid])) then
        return false
    elseif ((((FFN_State[pid] != 1) or (not FFP_Locked[pid])) or (ordinal != FFN_Count[pid])) or (FFN_Item[index] != null)) then
        return false
    endif
    set flags=FFP_Flags[index]
    set origin=FFP_Starter[pid]
    set carried=CreateItem(FFP_Raw[index],GetUnitX(origin),GetUnitY(origin))
    set FFN_Item[index]=carried
    set FFN_ItemRaw[index]=FFP_Raw[index]
    set FFN_Count[pid]=(ordinal + 1)
    if ((carried == null) or (GetItemTypeId(carried) != FFP_Raw[index])) then
        set carried=null
        set origin=null
        return false
    endif
    if FFP_Bound[index] then
        set binding=(pid + 1)
    endif
    call SetItemPlayer(carried,Player(pid),false)
    call SetItemCharges(carried,FFP_Quantity[index])
    call SetItemUserData(carried,binding)
    call SetItemInvulnerable(carried,(ModuloInteger(flags,2) == 1))
    call SaveSlots_SetDroppable(carried,(ModuloInteger((flags / 2),2) == 1))
    call SetItemPawnable(carried,(ModuloInteger((flags / 4),2) == 1))
    call SetWidgetLife(carried,FSL_Real(FFP_High[index],FFP_Low[index]))
    set carried=null
    set origin=null
    return FFN_MetadataMatches(pid,ordinal)
endfunction

function FFN_Allocate takes integer pid,boolean windowOpen returns boolean
    local integer selected
    local integer raw
    local integer variant
    local integer freeRaw=0
    local integer i=0
    if (not FSC_PlayerValid(pid)) then
        return false
    elseif ((FFN_State[pid] != 0) or FFP_Locked[pid]) then
        set FFN_Error[pid]="finish cleanup before another load attempt"
        return false
    elseif (not FFP_Recheck(pid,windowOpen)) then
        set FFN_Error[pid]=FFP_Error[pid]
        return false
    endif
    set FFP_Locked[pid]=true
    set FFN_State[pid]=1
    set FFN_Error[pid]=""
    call FFN_ClearRecords(pid)
    set selected=LoadInteger(FFP_Values,((pid * 16) + 4),13)
    set variant=LoadInteger(FFP_Values,((pid * 16) + 4),14)
    if (variant == 1) then
        set freeRaw='H02L'
    elseif (variant == 2) then
        set freeRaw='H02M'
    elseif (variant == 3) then
        set freeRaw='H02N'
    endif
    if (selected == 0) then
        set raw=freeRaw
    else
        set raw=FRC_JobRaw((selected - 1))
    endif
    if (not FFN_CreateUnit(pid,0,raw,FFP_Starter[pid])) then
        return FFN_Fail(pid,"saved hero allocation failed")
    endif
    if (not FFN_CreateUnit(pid,1,'H01D',FFP_Gaya[pid])) then
        return FFN_Fail(pid,"Gaya allocation failed")
    endif
    if ((selected != 0) and (freeRaw != 0)) then
        if (not FFN_CreateUnit(pid,2,freeRaw,FFP_Starter[pid])) then
            return FFN_Fail(pid,"saved Freelancer allocation failed")
        endif
    endif
    loop
        exitwhen (i >= FFP_Count[pid])
        if (not FFN_CreateItem(pid,i)) then
            return FFN_Fail(pid,FSS_Concat("item allocation or metadata failed at record ",I2S((i + 1))))
        endif
        set i=(i + 1)
    endloop
    // Allocated is not loaded: progression, placement and verification still follow.
    set FFN_State[pid]=2
    return true
endfunction
function InitTrig_ForsakenSaveFreshObjects takes nothing returns nothing
endfunction
endlibrary
