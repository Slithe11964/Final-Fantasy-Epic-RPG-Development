library TForsakenSaveTransport requires TForsakenSaveCodec, TForsakenSaveCache
// Generated by tools/save_port.py from experiments/Forsaken/Forsaken-save-transport.j (the Reforged save).
// Edit that file and regenerate; slot adapters and bounded runtime strings preserve the format.
// File IO remains local; only ordered sync packets reach detached validation.
globals
    constant string FST_PREFIX="FSCU"
    // Reforged shares packets through the sync natives; the 1.29.2 build flips this
    // constant to false and carries the same packets in the game cache instead.
    constant boolean FST_UseSyncNative=true
    boolean FST_SyncSent=false
    constant string FST_FILE=".\\FFERPG\\Forsaken CU.txt"
    constant integer FST_LIMIT=17000
    // One file page holds 23 player-name chunks. FST_CHUNK sizes the chunks this build writes;
    // test builds may shrink it to split ordinary saves into several files
    // (build_save_roundtrip.py --small-file-pages). Reading accepts any chunk size up to
    // FST_MAXCHUNK, so files written by another build still load; length and checksum verify them.
    constant integer FST_CHUNK=160
    constant integer FST_PAGE=23*FST_CHUNK
    constant integer FST_MAXCHUNK=160
    boolean array FST_AllowLegacy
    boolean array FST_Legacy
    boolean array FST_LegacySaveMessages
    string array FST_SavedCode
    string array FST_FileStem
    string array FST_FileError
    string array FST_FileBefore
    timer FST_Clock=null
    timer FST_PumpTimer=null
    trigger FST_Sync=null
    integer array FST_RequestId
    integer array FST_Account
    boolean array FST_Pending
    boolean array FST_Receiving
    boolean array FST_Ready
    string array FST_Buffer
    string array FST_Result
    string array FST_Error
    integer array FST_Length
    integer array FST_Check
    integer array FST_Sequence
    real array FST_Start
    integer array FST_SendMillis
    real array FST_ReceiveStart
    real array FST_TransferSeconds
    integer array FST_FileMillis
    // These arrays are read only inside the owning client's local branch.
    string array FST_LocalCode
    integer array FST_LocalPhase
    integer array FST_LocalSequence
    integer array FST_LocalMillis
    integer array FST_LocalCheck
    boolean array FST_LocalLegacy
    integer array FST_LocalHashPosition
    integer array FST_LocalHashA
    integer array FST_LocalHashB
endglobals

function FST_Digits takes string text returns integer
    local integer position=0
    local integer digit
    local integer value=0
    loop
        exitwhen (position >= FSS_Length(text))
        set digit=0
        loop
            exitwhen ((digit >= 10) or (FSS_Equals(FSS_SubString("0123456789",digit,(digit + 1)),FSS_SubString(text,position,(position + 1)))))
            set digit=(digit + 1)
        endloop
        if (((digit >= 10) or (value > 214748364)) or (((value == 214748364) and (digit > 7)))) then
            return (- 1)
        endif
        set value=((value * 10) + digit)
        set position=(position + 1)
    endloop
    if (position == 0) then
        return (- 1)
    endif
    return value
endfunction

function FST_Fixed takes integer value,integer width returns string
    local string text=I2S(value)
    if ((value < 0) or (FSS_Length(text) > width)) then
        return null
    endif
    loop
        exitwhen (FSS_Length(text) >= width)
        set text=FSS_Concat("0",text)
    endloop
    return text
endfunction

function FST_Fail takes integer pid,string reason returns nothing
    set FST_Error[pid]=FSS_SetRoot(reason,1616153064,pid,false)
    set FST_Pending[pid]=false
    set FST_Receiving[pid]=false
    set FST_Legacy[pid]=false
    set FST_Ready[pid]=false
    set FST_Buffer[pid]=FSS_SetRoot(null,942952999,pid,false)
    set FST_Result[pid]=FSS_SetRoot(null,436495302,pid,false)
endfunction

function FST_FilePath takes integer page returns string
    if (page == 0) then
        return FST_FILE
    endif
    return FSS_Concat(FSS_Concat(".\\FFERPG\\Forsaken CU part ",I2S(page)),".txt")
endfunction

function FST_SetFileStem takes integer pid,string stem returns boolean
    local integer i=0
    local integer j
    local string allowed="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 _-"
    local string character
    if ((FSS_Length(stem) < 1) or (FSS_Length(stem) > 64)) then
        return false
    endif
    loop
        exitwhen (i >= FSS_Length(stem))
        set character=FSS_SubString(stem,i,(i + 1))
        set j=0
        loop
            exitwhen ((j >= FSS_Length(allowed)) or (FSS_Equals(FSS_SubString(allowed,j,(j + 1)),character)))
            set j=(j + 1)
        endloop
        if (j >= FSS_Length(allowed)) then
            return false
        endif
        set i=(i + 1)
    endloop
    set FST_FileStem[pid]=FSS_SetRoot(stem,640864328,pid,false)
    return true
endfunction

function FST_PlayerPath takes integer pid,integer page returns string
    if ((FSS_Equals(FST_FileStem[pid],null)) or (FSS_Equals(FST_FileStem[pid],""))) then
        return FST_FilePath(page)
    endif
    if (page == 0) then
        return FSS_Concat(FSS_Concat(".\\FFERPG\\",FST_FileStem[pid]),".txt")
    endif
    return FSS_Concat(FSS_Concat(FSS_Concat(FSS_Concat(".\\FFERPG\\",FST_FileStem[pid])," part "),I2S(page)),".txt")
endfunction

function FST_TextChecksum takes string text returns integer
    return FSS_Scan(text,2)
endfunction

function FST_LegacyValid takes string encoded returns boolean
    local integer i=0
    local string ch
    if ((((FSS_Equals(encoded,null)) or (FSS_Length(encoded) < 11)) or (FSS_Length(encoded) > FST_LIMIT)) or (((((not FSS_Equals(FSS_SubString(encoded,0,1),"E")) and (not FSS_Equals(FSS_SubString(encoded,0,1),"F"))) and (not FSS_Equals(FSS_SubString(encoded,0,1),"G"))) and (not FSS_Equals(FSS_SubString(encoded,0,1),"H"))))) then
        return false
    endif
    loop
        exitwhen (i >= FSS_Length(encoded))
        set ch=FSS_SubString(encoded,i,(i + 1))
        if (((not FSS_Equals(ch,"(")) and (not FSS_Equals(ch,")"))) and (not FSC_AlphabetValid(ch))) then
            return false
        endif
        set i=(i + 1)
    endloop
    return true
endfunction

function FST_ColorCode takes string text returns string
    local integer i=0
    local integer value
    local string color
    local string previous=""
    local string result=""
    loop
        exitwhen (i >= FSS_Length(text))
        set value=FSC_Value(FSS_SubString(text,i,(i + 1)))
        if (value < 26) then
            set color="|c00C8C8C8"
        elseif (value < 52) then
            set color="|c00E6E700"
        elseif (value < 62) then
            set color="|c000068DE"
        else
            set color="|c0016D116"
        endif
        // Change color only when the character category changes; keep native text bounded.
        if (not FSS_Equals(color,previous)) then
            set result=FSS_Concat(result,color)
            set previous=color
        endif
        set result=FSS_Concat(result,FSS_SubString(text,i,(i + 1)))
        set i=(i + 1)
    endloop
    return FSS_Concat(result,"|r")
endfunction

function FST_ShowCode takes integer pid,integer page returns boolean
    local string encoded=FST_SavedCode[pid]
    local integer total=(((FSS_Length(encoded) + 79)) / 80)
    local integer pages=(((total + 2)) / 3)
    local integer part=(((page - 1)) * 3)
    local integer last=(part + 3)
    if (((FSS_Equals(encoded,null)) or (page < 1)) or (page > pages)) then
        call DisplayTimedTextToPlayer(Player(pid),0.,0.,30.,"Save code: use -save first, then -savepage NUMBER for an available page.")
        return false
    endif
    if (GetLocalPlayer() == Player(pid)) then
        call ClearTextMessages()
    endif
    call DisplayTimedTextToPlayer(Player(pid),0.,0.,120.,FSS_Concat(FSS_Concat(FSS_Concat(FSS_Concat("|cFFFFCC00SAVE CODE - PAGE ",I2S(page))," OF "),I2S(pages)),"|r"))
    loop
        exitwhen ((part >= total) or (part >= last))
        call DisplayTimedTextToPlayer(Player(pid),0.,0.,120.,FSS_Concat(FSS_Concat(FSS_Concat(FSS_Concat(FSS_Concat(FSS_Concat(FSS_Concat("-load FSVB:",I2S(FST_TextChecksum(encoded))),":"),I2S((part + 1))),":"),I2S(total)),":"),FST_ColorCode(FSS_SubString(encoded,(part * 80),(((part + 1)) * 80)))))
        set part=(part + 1)
    endloop
    call DisplayTimedTextToPlayer(Player(pid),0.,0.,120.,FSS_Concat(FSS_Concat(FSS_Concat(FSS_Concat(FSS_Concat(FSS_Concat("|cFFFFCC00SCREENSHOT PAGE ",I2S(page))," OF "),I2S(pages))," - Capture ALL "),I2S(pages))," pages.|r"))
    if (page < pages) then
        call DisplayTimedTextToPlayer(Player(pid),0.,0.,120.,FSS_Concat(FSS_Concat("Next: -savepage ",I2S((page + 1))),". Paste all numbered -load lines in a fresh game."))
    else
        call DisplayTimedTextToPlayer(Player(pid),0.,0.,120.,"FINAL PAGE. Review: -savepage NUMBER. Paste all numbered -load lines in a fresh game.")
    endif
    return true
endfunction

// Local player names are temporary chunk fields; no native reads inside the file.
function FST_ReadFile takes integer pid returns string
    local integer slot=0
    local integer page=0
    local integer pages=1
    local integer size=0
    local integer check=0
    local integer wanted
    local string marker
    local string value
    local string result=""
    local boolean legacy=false
    set FST_FileError[pid]=FSS_SetRoot("",1975316070,pid,true)
    set FST_LocalCheck[pid]=0
    set FST_LocalLegacy[pid]=false
    loop
        exitwhen (slot >= 24)
        set FST_FileBefore[slot]=FSS_SetRoot(GetPlayerName(Player(slot)),1530968379,slot,true)
        set slot=(slot + 1)
    endloop
    loop
        exitwhen ((page >= pages) or (not FSS_Equals(FST_FileError[pid],"")))
        set slot=0
        loop
            exitwhen (slot >= 24)
            call SetPlayerName(Player(slot),"FSCU_UNREAD")
            set slot=(slot + 1)
        endloop
        call Preloader(FST_PlayerPath(pid,page))
        set marker=GetPlayerName(Player(23))
        if ((((page == 0) and (FSS_Equals(marker,"FSCU_UNREAD"))) and FST_AllowLegacy[pid]) and (not FSS_Equals(GetPlayerName(Player(pid)),"FSCU_UNREAD"))) then
            set result=GetPlayerName(Player(pid))
            set legacy=true
            set size=FSS_Length(result)
        elseif ((FSS_Length(marker) != 21) or (not FSS_Equals(FSS_SubString(marker,0,4),"FSC1"))) then
            set FST_FileError[pid]=FSS_SetRoot(FSS_LocalConcat(FSS_LocalConcat("page ",I2S(page))," header was not returned"),1975316070,pid,true)
        else
            if (page == 0) then
                set size=FST_Digits(FSS_SubString(marker,4,9))
                set check=FST_Digits(FSS_SubString(marker,9,19))
                set pages=FST_Digits(FSS_SubString(marker,20,21))
            endif
            if ((((((((((size < 4) or (size > FST_LIMIT)) or (check < 0)) or (pages < 1)) or (pages > size)) or (size > ((pages * 23) * FST_MAXCHUNK))) or (FST_Digits(FSS_SubString(marker,19,20)) != page)) or (FST_Digits(FSS_SubString(marker,4,9)) != size)) or (FST_Digits(FSS_SubString(marker,9,19)) != check)) or (FST_Digits(FSS_SubString(marker,20,21)) != pages)) then
                set FST_FileError[pid]=FSS_SetRoot(FSS_LocalConcat(FSS_LocalConcat("page ",I2S(page))," header mismatch"),1975316070,pid,true)
            endif
        endif
        set slot=0
        loop
            exitwhen (((slot >= 23) or (not FSS_Equals(FST_FileError[pid],""))) or (FSS_Length(result) >= size))
            set value=GetPlayerName(Player(slot))
            set wanted=(size - FSS_Length(result))
            if (wanted > FST_MAXCHUNK) then
                set wanted=FST_MAXCHUNK
            endif
            if ((FSS_Length(value) < 1) or (FSS_Length(value) > wanted)) then
                set FST_FileError[pid]=FSS_SetRoot(FSS_LocalConcat(FSS_LocalConcat(FSS_LocalConcat(FSS_LocalConcat(FSS_LocalConcat(FSS_LocalConcat(FSS_LocalConcat("page ",I2S(page))," chunk "),I2S(slot))," expected 1 to "),I2S(wanted))," received "),I2S(FSS_Length(value))),1975316070,pid,true)
            else
                set result=FSS_LocalConcat(result,value)
            endif
            set slot=(slot + 1)
        endloop
        set page=(page + 1)
    endloop
    set slot=0
    loop
        exitwhen (slot >= 24)
        call SetPlayerName(Player(slot),FST_FileBefore[slot])
        set FST_FileBefore[slot]=FSS_SetRoot(null,1530968379,slot,true)
        set slot=(slot + 1)
    endloop
    if (not FSS_Equals(FST_FileError[pid],"")) then
        return null
    endif
    // Only framing is inspected privately. Content validation runs on every receiver.
    if (FSS_Length(result) != size) then
        set FST_FileError[pid]=FSS_SetRoot("assembled length mismatch",1975316070,pid,true)
        return null
    endif
    set FST_LocalCheck[pid]=check
    set FST_LocalLegacy[pid]=legacy
    return result
endfunction

// Called only from synchronized controller input after checking its load eligibility.
function FST_Request takes integer pid,integer account returns boolean
    local string before
    local string encoded
    local real started
    if ((((not FSC_PlayerValid(pid)) or FST_Pending[pid]) or (FST_Clock == null)) or (FST_RequestId[pid] >= 999999)) then
        return false
    endif
    set FST_RequestId[pid]=(FST_RequestId[pid] + 1)
    set FST_Account[pid]=account
    set FST_Pending[pid]=true
    set FST_Receiving[pid]=false
    set FST_Ready[pid]=false
    set FST_Error[pid]=FSS_SetRoot("",1616153064,pid,false)
    set FST_Result[pid]=FSS_SetRoot(null,436495302,pid,false)
    set FST_Buffer[pid]=FSS_SetRoot("",942952999,pid,false)
    set FST_Start[pid]=TimerGetElapsed(FST_Clock)
    if (GetLocalPlayer() == Player(pid)) then
        set before=GetPlayerName(Player(pid))
        set started=TimerGetElapsed(FST_Clock)
        set encoded=FST_ReadFile(pid)
        call SetPlayerName(Player(pid),before)
        set FST_LocalMillis[pid]=R2I((((TimerGetElapsed(FST_Clock) - started)) * 1000.))
        if (((FSS_Equals(encoded,null)) or (FSS_Length(encoded) < 4)) or (FSS_Length(encoded) > FST_LIMIT)) then
            set FST_LocalCode[pid]=FSS_SetRoot(null,1002168606,pid,true)
            set FST_LocalPhase[pid]=4
        else
            set FST_LocalCode[pid]=FSS_SetRoot(encoded,1002168606,pid,true)
            set FST_LocalPhase[pid]=1
            if FST_LocalLegacy[pid] then
                // Legacy files have no checksum header. Prepare it in bounded local steps;
                // do not enter the shared scanner or ExecuteFunc from private IO.
                set FST_LocalPhase[pid]=5
                set FST_LocalHashPosition[pid]=0
                set FST_LocalHashA[pid]=1
                set FST_LocalHashB[pid]=0
            endif
            set FST_LocalSequence[pid]=0
        endif
    endif
    return true
endfunction

// Only the owning client's sender calls this. No shared scan scratch or child threads.
function FST_LocalLegacyHash takes integer pid returns nothing
    local integer position=FST_LocalHashPosition[pid]
    local integer last=(position + 128)
    local integer digit
    local string letter
    loop
        exitwhen ((position >= last) or (position >= FSS_Length(FST_LocalCode[pid])))
        set letter=FSS_SubString(FST_LocalCode[pid],position,(position + 1))
        if (FSS_Equals(letter,"(")) then
            set digit=64
        elseif (FSS_Equals(letter,")")) then
            set digit=65
        else
            set digit=FSC_Value(letter)
        endif
        if (digit < 0) then
            set FST_LocalPhase[pid]=4
            return
        endif
        set FST_LocalHashA[pid]=ModuloInteger(((FST_LocalHashA[pid] + digit) + 1),32749)
        set FST_LocalHashB[pid]=ModuloInteger((FST_LocalHashB[pid] + FST_LocalHashA[pid]),32749)
        set position=(position + 1)
    endloop
    set FST_LocalHashPosition[pid]=position
    if (position >= FSS_Length(FST_LocalCode[pid])) then
        set FST_LocalCheck[pid]=((FST_LocalHashB[pid] * 32768) + FST_LocalHashA[pid])
        set FST_LocalPhase[pid]=1
    endif
endfunction

// Accepts only the currently requested sender's complete, ordered envelope.
function FST_Receive takes integer pid,string packet returns nothing
    local string kind
    local integer request
    local integer sequence
    local integer size
    local string chunk
    if ((((not FSC_PlayerValid(pid)) or (not FST_Pending[pid])) or (FSS_Equals(packet,null))) or (FSS_Length(packet) < 7)) then
        return
    endif
    set request=FST_Digits(FSS_SubString(packet,1,7))
    if (request != FST_RequestId[pid]) then
        return
    endif
    set kind=FSS_SubString(packet,0,1)
    if ((FSS_Equals(kind,"B")) or (FSS_Equals(kind,"L"))) then
        set FST_Legacy[pid]=(FSS_Equals(kind,"L"))
        if (FST_Legacy[pid] and (not FST_AllowLegacy[pid])) then
            call FST_Fail(pid,"legacy import was not requested")
            return
        endif
        if (FST_Receiving[pid] or (FSS_Length(packet) != 37)) then
            call FST_Fail(pid,"duplicate or malformed file header")
            return
        endif
        set size=FST_Digits(FSS_SubString(packet,7,12))
        set FST_Check[pid]=FST_Digits(FSS_SubString(packet,12,22))
        set FST_FileMillis[pid]=FST_Digits(FSS_SubString(packet,22,28))
        set FST_SendMillis[pid]=FST_Digits(FSS_SubString(packet,28,37))
        if ((((((size < 4) or (size > FST_LIMIT)) or (FST_Check[pid] < 0)) or (FST_FileMillis[pid] < 0)) or (FST_SendMillis[pid] < 0)) or (FST_SendMillis[pid] > (R2I((TimerGetElapsed(FST_Clock) * 1000.)) + 1))) then
            call FST_Fail(pid,"invalid file length or checksum header")
            return
        endif
        set FST_Length[pid]=size
        set FST_Sequence[pid]=0
        set FST_Buffer[pid]=FSS_SetRoot("",942952999,pid,false)
        set FST_ReceiveStart[pid]=TimerGetElapsed(FST_Clock)
        set FST_Receiving[pid]=true
        call DisplayTimedTextToPlayer(Player(pid),0.,0.,15.,"Loading: file found; transferring data...")
    elseif (FSS_Equals(kind,"D")) then
        set sequence=FST_Digits(FSS_SubString(packet,7,10))
        set chunk=FSS_SubString(packet,10,FSS_Length(packet))
        set size=(FST_Length[pid] - FSS_Length(FST_Buffer[pid]))
        if (size > 192) then
            set size=192
        endif
        if (((((not FST_Receiving[pid]) or (sequence != FST_Sequence[pid])) or (size <= 0)) or (FSS_Length(chunk) != size)) or (((not FST_Legacy[pid]) and (not FSC_AlphabetValid(chunk))))) then
            call FST_Fail(pid,"missing, repeated or invalid encoded chunk")
            return
        endif
        set FST_Buffer[pid]=FSS_SetRoot(FSS_Concat(FST_Buffer[pid],chunk),942952999,pid,false)
        set FST_Sequence[pid]=(sequence + 1)
    elseif (FSS_Equals(kind,"E")) then
        if ((((FSS_Length(packet) != 7) or (not FST_Receiving[pid])) or (FSS_Length(FST_Buffer[pid]) != FST_Length[pid])) or (FST_TextChecksum(FST_Buffer[pid]) != FST_Check[pid])) then
            call FST_Fail(pid,"incomplete or corrupted file transfer")
            return
        endif
        call DisplayTimedTextToPlayer(Player(pid),0.,0.,15.,"Loading: file received; checking profile...")
        if (((FST_Legacy[pid] and (not FST_LegacyValid(FST_Buffer[pid])))) or (((not FST_Legacy[pid]) and (not FSC_Decode(pid,FST_Buffer[pid],FST_Account[pid],true))))) then
            call FST_Fail(pid,"file profile failed validation")
            return
        endif
        set FST_Result[pid]=FSS_SetRoot(FST_Buffer[pid],436495302,pid,false)
        set FST_Buffer[pid]=FSS_SetRoot(null,942952999,pid,false)
        set FST_TransferSeconds[pid]=(TimerGetElapsed(FST_Clock) - (I2R(FST_SendMillis[pid]) / 1000.))
        set FST_Pending[pid]=false
        set FST_Receiving[pid]=false
        set FST_Ready[pid]=true
    elseif (FSS_Equals(kind,"X")) then
        call FST_Fail(pid,"file missing, unreadable or invalid; no character changed")
    else
        call FST_Fail(pid,"unknown file transfer packet")
    endif
endfunction

// The sync natives live only in these wrappers: the 1.29.2 conversion empties them.
function FSTSync_OnSync takes nothing returns nothing
    call FST_Receive(GetPlayerId(GetTriggerPlayer()),BlzGetTriggerSyncData())
endfunction

function FSTSync_Send takes string packet returns nothing
    set FST_SyncSent=BlzSendSyncData(FST_PREFIX,packet)
endfunction

function FSTSync_Register takes trigger whichTrigger,integer pid returns nothing
    call BlzTriggerRegisterPlayerSyncEvent(whichTrigger,Player(pid),FST_PREFIX,false)
endfunction

// Hands any packets that arrived through the game cache to the same reader.
function FST_Drain takes integer pid returns nothing
    local integer waiting=FSG_Waiting(pid)
    local string packet
    // One packet per player/tick bounds catch-up work when cache keys arrive together.
    if (FSG_Seen[pid] >= waiting) then
        return
    endif
    set packet=FSG_Packet(pid,FSG_Seen[pid])
    if (not FSS_Equals(packet,null)) then
        set FSG_Seen[pid]=(FSG_Seen[pid] + 1)
        call FST_Receive(pid,packet)
    endif
endfunction

function FST_Pump takes nothing returns nothing
    local integer pid=0
    local integer sequence
    local string packet
    local string request
    loop
        exitwhen (pid >= 8)
        if FST_Pending[pid] then
            if ((TimerGetElapsed(FST_Clock) - FST_Start[pid]) > 45.) then
                call FST_Fail(pid,"file transfer timed out; retry while load window is open")
            else
                if (not FST_UseSyncNative) then
                    call FST_Drain(pid)
                endif
            endif
            if (FST_Pending[pid] and (GetLocalPlayer() == Player(pid))) then
                set request=FST_Fixed(FST_RequestId[pid],6)
                set packet=null
                if (FST_LocalPhase[pid] == 5) then
                    call FST_LocalLegacyHash(pid)
                elseif (FST_LocalPhase[pid] == 1) then
                    set packet="B"
                    if FST_LocalLegacy[pid] then
                        set packet="L"
                    endif
                    set packet=FSS_Concat(FSS_Concat(FSS_Concat(FSS_Concat(FSS_Concat(packet,request),FST_Fixed(FSS_Length(FST_LocalCode[pid]),5)),FST_Fixed(FST_LocalCheck[pid],10)),FST_Fixed(FST_LocalMillis[pid],6)),FST_Fixed(R2I((TimerGetElapsed(FST_Clock) * 1000.)),9))
                    set FST_LocalPhase[pid]=2
                elseif (FST_LocalPhase[pid] == 2) then
                    set sequence=FST_LocalSequence[pid]
                    if ((sequence * 192) >= FSS_Length(FST_LocalCode[pid])) then
                        set packet=FSS_Concat("E",request)
                        set FST_LocalPhase[pid]=0
                        set FST_LocalCode[pid]=FSS_SetRoot(null,1002168606,pid,true)
                    else
                        set packet=FSS_Concat(FSS_Concat(FSS_Concat("D",request),FST_Fixed(sequence,3)),FSS_SubString(FST_LocalCode[pid],(sequence * 192),(((sequence + 1)) * 192)))
                        set FST_LocalSequence[pid]=(sequence + 1)
                    endif
                elseif (FST_LocalPhase[pid] == 4) then
                    set packet=FSS_Concat("X",request)
                    set FST_LocalPhase[pid]=0
                    set FST_LocalCode[pid]=FSS_SetRoot(null,1002168606,pid,true)
                endif
                if (not FSS_Equals(packet,null)) then
                    if FST_UseSyncNative then
                        call FSTSync_Send(packet)
                    else
                        set FST_SyncSent=FSG_Send(pid,packet)
                    endif
                    if (not FST_SyncSent) then
                        // Report failure on the next tick, or time out.
                        set FST_LocalPhase[pid]=4
                    endif
                endif
            endif
        endif
        set pid=(pid + 1)
    endloop
endfunction

function FST_Write takes integer pid,string encoded,integer account returns boolean
    local integer position=0
    local integer checksum=0
    local integer page=0
    local integer pages
    local integer slot
    local string marker
    local string before
    local string readback
    if (((((not FSC_PlayerValid(pid)) or FST_Pending[pid]) or (FSS_Equals(encoded,null))) or (FSS_Length(encoded) > FST_LIMIT)) or (not FSC_Decode(pid,encoded,account,true))) then
        return false
    endif
    set checksum=FST_TextChecksum(encoded)
    if (GetLocalPlayer() == Player(pid)) then
        set pages=((((FSS_Length(encoded) + FST_PAGE) - 1)) / FST_PAGE)
        loop
            exitwhen (page >= pages)
            call PreloadGenClear()
            call PreloadGenStart()
            set slot=0
            loop
                exitwhen ((slot >= 23) or (position >= FSS_Length(encoded)))
                call Preload(FSS_Concat(FSS_Concat(FSS_Concat(FSS_Concat("\")\r\n\tcall SetPlayerName(Player(",I2S(slot)),"), \""),FSS_SubString(encoded,position,(position + FST_CHUNK))),"\")\r\n\t//"))
                set position=(position + FST_CHUNK)
                set slot=(slot + 1)
            endloop
            set marker=FSS_Concat(FSS_Concat(FSS_Concat(FSS_Concat("FSC1",FST_Fixed(FSS_Length(encoded),5)),FST_Fixed(checksum,10)),FST_Fixed(page,1)),FST_Fixed(pages,1))
            call Preload(FSS_Concat(FSS_Concat("\")\r\n\tcall SetPlayerName(Player(23), \"",marker),"\")\r\n\treturn\r\n\t//"))
            call PreloadGenEnd(FST_PlayerPath(pid,page))
            set page=(page + 1)
        endloop
        if (not FST_LegacySaveMessages[pid]) then
            call DisplayTimedTextToPlayer(Player(pid),0.,0.,30.,"Save file written; checking it...")
        endif
        set before=GetPlayerName(Player(pid))
        set readback=FST_ReadFile(pid)
        call SetPlayerName(Player(pid),before)
        if ((FSS_Equals(readback,encoded)) and (FST_LocalCheck[pid] == checksum)) then
            if FST_LegacySaveMessages[pid] then
                call DisplayTimedTextToPlayer(Player(pid),0.,0.,30.,"Saved successfully")
            else
                call DisplayTimedTextToPlayer(Player(pid),0.,0.,30.,FSS_Concat("|cff00ff00Saved.|r File: ",FST_PlayerPath(pid,0)))
            endif
        elseif FST_LegacySaveMessages[pid] then
            call DisplayTimedTextToPlayer(Player(pid),0.,0.,30.,"Saved but could not verify if successful. Check saves folder manually.")
        elseif ((FSS_Equals(readback,null)) or (FSS_Equals(readback,""))) then
            call DisplayTimedTextToPlayer(Player(pid),0.,0.,30.,FSS_Concat(FSS_Concat("Saved, but the file could not be checked (",FST_FileError[pid]),"). Save again to be sure."))
        else
            call DisplayTimedTextToPlayer(Player(pid),0.,0.,30.,"Saved, but the file did not read back the same. Save again to be sure.")
        endif
    endif
    // Synchronized return means validated export attempted, not local readback success.
    return true
endfunction

function FST_Init takes nothing returns nothing
    local integer pid=0
    if (FST_Clock != null) then
        return
    endif
    // Allocate the lookup synchronously before any local file read.
    call FSC_InitCharacters()
    call FSS_InitCollector()
    set FST_Clock=CreateTimer()
    call TimerStart(FST_Clock,86400.,false,null)
    set FST_PumpTimer=CreateTimer()
    call TimerStart(FST_PumpTimer,0.05,true,function FST_Pump)
    set FST_Sync=CreateTrigger()
    if FST_UseSyncNative then
        loop
            exitwhen (pid >= 8)
            call FSTSync_Register(FST_Sync,pid)
            set pid=(pid + 1)
        endloop
        call TriggerAddAction(FST_Sync,function FSTSync_OnSync)
    else
        call FSG_Init()
    endif
endfunction
function InitTrig_ForsakenSaveTransport takes nothing returns nothing
endfunction
endlibrary
