    call SaveStr(SpellCalcData,'A18H',111,"|n|n|cffffcc00Damage details|r|nFinal strike damage: (1200 + 3 x STR + 3 x AGI) x (1 + 10% x Katana proficiency). Each spinning damage tick deals 10% of that amount.|nSTR/AGI/INT include bonuses. Mana fraction = current MP / maximum MP at cast time. Values are before damage bonuses, defenses and hit rolls; integer divisions round down.")
    call SaveInteger(SpellCalcData,'A18H',-1,0)
    call SaveInteger(SpellCalcData,'A18H',-2,0)
    set SpellCalcRaw[99]='A18P'
    call SaveStr(SpellCalcData,'A18P',1,"|cffffcc00Katana Technique|r|nSlices through a single target with a clean strike. If used during a combo, deals extra damage based on the amount of hits. If Iainuki kills the enemy, it has no cooldown.")
    call SaveStr(SpellCalcData,'A18P',101,"|n|n|cffffcc00Damage details|r|nDamage: (3000 + 8 x STR + 8 x AGI) x (1 + 10% x Katana proficiency). During Combo Strike, multiply by (1 + 10% x recorded combo hits).|nSTR/AGI/INT include bonuses. Mana fraction = current MP / maximum MP at cast time. Values are before damage bonuses, defenses and hit rolls; integer divisions round down.")
    call SaveStr(SpellCalcData,'A18P',2,"|cffffcc00Katana Technique|r|nSlices through a single target with a clean strike. If used during a combo, deals extra damage based on the amount of hits. If Iainuki kills the enemy, it has no cooldown.")
    call SaveStr(SpellCalcData,'A18P',102,"|n|n|cffffcc00Damage details|r|nDamage: (3500 + 8 x STR + 8 x AGI) x (1 + 10% x Katana proficiency). During Combo Strike, multiply by (1 + 10% x recorded combo hits).|nSTR/AGI/INT include bonuses. Mana fraction = current MP / maximum MP at cast time. Values are before damage bonuses, defenses and hit rolls; integer divisions round down.")
    call SaveStr(SpellCalcData,'A18P',3,"|cffffcc00Katana Technique|r|nSlices through a single target with a clean strike. If used during a combo, deals extra damage based on the amount of hits. If Iainuki kills the enemy, it has no cooldown.")
    call SaveStr(SpellCalcData,'A18P',103,"|n|n|cffffcc00Damage details|r|nDamage: (4000 + 8 x STR + 8 x AGI) x (1 + 10% x Katana proficiency). During Combo Strike, multiply by (1 + 10% x recorded combo hits).|nSTR/AGI/INT include bonuses. Mana fraction = current MP / maximum MP at cast time. Values are before damage bonuses, defenses and hit rolls; integer divisions round down.")
    call SaveStr(SpellCalcData,'A18P',4,"|cffffcc00Katana Technique|r|nSlices through a single target with a clean strike. If used during a combo, deals extra damage based on the amount of hits. If Iainuki kills the enemy, it has no cooldown.")
    call SaveStr(SpellCalcData,'A18P',104,"|n|n|cffffcc00Damage details|r|nDamage: (4500 + 8 x STR + 8 x AGI) x (1 + 10% x Katana proficiency). During Combo Strike, multiply by (1 + 10% x recorded combo hits).|nSTR/AGI/INT include bonuses. Mana fraction = current MP / maximum MP at cast time. Values are before damage bonuses, defenses and hit rolls; integer divisions round down.")
    call SaveStr(SpellCalcData,'A18P',5,"|cffffcc00Katana Technique|r|nSlices through a single target with a clean strike. If used during a combo, deals extra damage based on the amount of hits. If Iainuki kills the enemy, it has no cooldown.")
    call SaveStr(SpellCalcData,'A18P',105,"|n|n|cffffcc00Damage details|r|nDamage: (5000 + 8 x STR + 8 x AGI) x (1 + 10% x Katana proficiency). During Combo Strike, multiply by (1 + 10% x recorded combo hits).|nSTR/AGI/INT include bonuses. Mana fraction = current MP / maximum MP at cast time. Values are before damage bonuses, defenses and hit rolls; integer divisions round down.")
    call SaveStr(SpellCalcData,'A18P',6,"|cffffcc00Katana Technique|r|nSlices through a single target with a clean strike. If used during a combo, deals extra damage based on the amount of hits. If Iainuki kills the enemy, it has no cooldown.")
    call SaveStr(SpellCalcData,'A18P',106,"|n|n|cffffcc00Damage details|r|nDamage: (6000 + 8 x STR + 8 x AGI) x (1 + 10% x Katana proficiency). During Combo Strike, multiply by (1 + 10% x recorded combo hits).|nSTR/AGI/INT include bonuses. Mana fraction = current MP / maximum MP at cast time. Values are before damage bonuses, defenses and hit rolls; integer divisions round down.")
    call SaveInteger(SpellCalcData,'A18P',-1,0)
    call SaveInteger(SpellCalcData,'A18P',-2,0)
    set SpellCalcRaw[100]='A19P'
    call SaveStr(SpellCalcData,'A19P',1,"Conjures a pillar of fire that repeatedly burns enemies in the target area. Damage per pulse is shown below.")
    call SaveStr(SpellCalcData,'A19P',101,"|n|n|cffffcc00Damage details|r|nFire damage per damage pulse: (125 + floor(INT / 2)) x Rod spell power.|nRod spell power = 1 + 50% x mana fraction x (1 + 10% x effective Rod proficiency). Mind Charge doubles it; Concentration multiplies it by 1.5 at full mana. The same damage formula applies to both burning phases while the enemy remains in the fire.|nSTR/AGI/INT include bonuses. Mana fraction = current MP / maximum MP at cast time. Values are before damage bonuses, defenses and hit rolls; integer divisions round down.")
    call SaveInteger(SpellCalcData,'A19P',-1,0)
    call SaveInteger(SpellCalcData,'A19P',-2,0)
    set SpellCalcRaw[101]='A19Q'
    call SaveStr(SpellCalcData,'A19Q',1,"Ice erupts among a group of enemies, dealing damage and slowing them for 6 seconds.")
    call SaveStr(SpellCalcData,'A19Q',101,"|n|n|cffffcc00Damage details|r|nIce damage: (1500 + 4 x INT) x Rod spell power.|nRod spell power = 1 + 50% x mana fraction x (1 + 10% x effective Rod proficiency). Mind Charge doubles it; Concentration multiplies it by 1.5 at full mana.|nSTR/AGI/INT include bonuses. Mana fraction = current MP / maximum MP at cast time. Values are before damage bonuses, defenses and hit rolls; integer divisions round down.")
    call SaveInteger(SpellCalcData,'A19Q',-1,0)
    call SaveInteger(SpellCalcData,'A19Q',-2,0)
    set SpellCalcRaw[102]='A19R'
    call SaveStr(SpellCalcData,'A19R',1,"Lightning bolt strikes target unit, dealing damage and stunning him for 2 seconds.")
    call SaveStr(SpellCalcData,'A19R',101,"|n|n|cffffcc00Damage details|r|nDirect Thunder damage: (1000 + 3 x INT) x Rod spell power.|nRod spell power = 1 + 50% x mana fraction x (1 + 10% x effective Rod proficiency). Mind Charge doubles it; Concentration multiplies it by 1.5 at full mana. Each of the 10 outgoing bolts deals 30% of direct damage.|nSTR/AGI/INT include bonuses. Mana fraction = current MP / maximum MP at cast time. Values are before damage bonuses, defenses and hit rolls; integer divisions round down.")
    call SaveInteger(SpellCalcData,'A19R',-1,0)
    call SaveInteger(SpellCalcData,'A19R',-2,0)
    set SpellCalcRaw[103]='A1AT'
    call SaveStr(SpellCalcData,'A1AT',1,"|cffffcc00Katana Technique|r|nSpins around, drawing in nearby enemies in a gravitational pull before finally striking them all at once for heavy wind damage.")
    call SaveStr(SpellCalcData,'A1AT',101,"|n|n|cffffcc00Damage details|r|nFinal strike damage: (240 + 3 x STR + 3 x AGI) x (1 + 10% x Katana proficiency). Each spinning damage tick deals 10% of that amount.|nSTR/AGI/INT include bonuses. Mana fraction = current MP / maximum MP at cast time. Values are before damage bonuses, defenses and hit rolls; integer divisions round down.")
    call SaveInteger(SpellCalcData,'A1AT',-1,0)
    call SaveInteger(SpellCalcData,'A1AT',-2,0)
    set SpellCalcRaw[104]='A1F2'
    call SaveStr(SpellCalcData,'A1F2',1,"Calls down waves of meteors that damage units in an area, dealing heavy non-elemental damage.")
    call SaveStr(SpellCalcData,'A1F2',101,"|n|n|cffffcc00Damage details|r|nDamage per wave: (250 + floor(INT / 2)) x Inner Mana spell power.|nInner Mana spell power = 1 + 100% x mana fraction x (1 + 10% x effective Inner Mana proficiency). Mind Charge doubles it; Concentration multiplies it by 1.5 at full mana. 24 waves if all land.|nSTR/AGI/INT include bonuses. Mana fraction = current MP / maximum MP at cast time. Values are before damage bonuses, defenses and hit rolls; integer divisions round down.")
    call SaveInteger(SpellCalcData,'A1F2',-1,0)
    call SaveInteger(SpellCalcData,'A1F2',-2,0)
    set SpellCalcCount=105
endfunction


function SpellCalc_InitData takes nothing returns nothing
    call ExecuteFunc("SpellCalc_Data0")
    call ExecuteFunc("SpellCalc_Data1")
    call ExecuteFunc("SpellCalc_Data2")
    call ExecuteFunc("SpellCalc_Data3")
    call ExecuteFunc("SpellCalc_Data4")
    call ExecuteFunc("SpellCalc_Data5")
    call ExecuteFunc("SpellCalc_Data6")
    call ExecuteFunc("SpellCalc_Data7")
    call ExecuteFunc("SpellCalc_Data8")
    call ExecuteFunc("SpellCalc_Data9")
    call ExecuteFunc("SpellCalc_Data10")
    call ExecuteFunc("SpellCalc_Data11")
    call ExecuteFunc("SpellCalc_Data12")
    call ExecuteFunc("SpellCalc_Data13")
    call ExecuteFunc("SpellCalc_Data14")
endfunction


function SpellCalc_Tooltip takes unit hero,integer raw,integer rank returns string
    local string tip=LoadStr(SpellCalcData,raw,rank)
    local real amount
    local integer mana=BlzGetAbilityManaCost(raw,rank-1)
    local integer row=LoadInteger(SpellCalcData,raw,-1)
    local integer choice=LoadInteger(SpellCalcData,raw,-2)
    local real rate
    if not SpellCalcHidden[GetPlayerId(GetLocalPlayer())] then
        set tip=tip+LoadStr(SpellCalcData,raw,100+rank)
        if raw=='A00M' or raw=='A10K' then
            set amount=(I2R(mana)*5.+I2R(GetHeroInt(hero,true))*5.)*Prof_StaffPower(hero)
            set tip=tip+"|nCurrent caster: "+R2SW(amount,1,0)+" HP on impact; "+R2SW(amount*.25,1,0)+" HP along the path."
        elseif raw=='A04O' or raw=='A03O' or raw=='A05A' then
            set amount=(I2R(mana)*10.+I2R(GetHeroInt(hero,true))*5.)*Prof_StaffPower(hero)
            set tip=tip+"|nCurrent caster: "+R2SW(amount,1,0)+" base HP."
        elseif raw=='A0PC' then
            set amount=I2R(R2I(I2R(50+GetHeroInt(hero,true)/4)*Prof_StaffPower(hero)))
            set tip=tip+"|nCurrent caster: "+R2SW(amount,1,0)+" queued HP per second; up to "+R2SW(amount*.25,1,0)+" MP per second."
        elseif raw=='A089' or raw=='A06Q' then
            set amount=I2R(R2I((I2R(mana)*3.+I2R(GetHeroInt(hero,true))*3.)*Prof_StaffPower(hero)))
            set tip=tip+"|nCurrent caster: "+R2SW(amount,1,0)+" HP and "+R2SW(amount*.25,1,0)+" MP. Caster receives HP only."
        elseif raw=='A00L' then
            set rate=I2R(25+GetHeroInt(hero,true)/3)*Prof_StaffPower(hero)
            if Talent_Active(hero,12,2,3,raw) then
                set tip=tip+"|nSwiftmend: ("+R2SW(rate*2.,1,0)+" + 50% of target Strength) HP/sec for "+R2SW(PriestRegenDuration[rank]*.5,1,0)+" seconds, before recovery rolls."
            else
                set tip=tip+"|nCurrent caster: "+R2SW(rate,1,0)+" + 25% of target Strength HP/sec, before recovery rolls."
            endif
        elseif raw=='A0Z3' or raw=='A0DG' or raw=='A03L' then
            set amount=I2R(R2I(I2R((rank+4)*40+GetHeroInt(hero,true)*2)*Prof_StaffPower(hero)))
            set tip=tip+"|nCurrent caster: "+R2SW(amount,1,0)+" base MP drained."
        elseif raw=='A0Z4' or raw=='A07J' then
            set amount=I2R(R2I(I2R(mana*2+GetHeroInt(hero,true))*Prof_StaffPower(hero)))
            set tip=tip+"|nCurrent caster: "+R2SW(amount,1,0)+" base damage/sec; heals actual damage dealt."
        endif
    endif
    if row>0 and Talent_Active(hero,12,row,choice,raw) then
        set tip=tip+"|n|n|cffffcc00Talent: "+TalentName[Talent_Index(12,row,choice)]+"|r|n"+TalentText[Talent_Index(12,row,choice)]
        if raw=='A0OM' and not SpellCalcHidden[GetPlayerId(GetLocalPlayer())] then
            set amount=I2R(R2I(PriestRainHealing[rank]/PriestRainPeriod[rank]*.5+.5))
            set tip=tip+"|nCurrent split: "+R2SW(amount,1,0)+" base HP/sec and "+R2SW(amount,1,0)+" magic damage/sec."
        endif
    endif
    return tip
endfunction


function SpellCalc_Update takes nothing returns nothing
    local unit hero=Player_GetHero(GetLocalPlayer())
    local integer i=0
    local integer raw
    local integer rank
    local string tip
    if hero!=null then
        loop
            exitwhen i>=SpellCalcCount
            set raw=SpellCalcRaw[i]
            set rank=GetUnitAbilityLevel(hero,raw)
            if rank>0 then
                set tip=SpellCalc_Tooltip(hero,raw,rank)
                if not HaveSavedInteger(SpellCalcLast,raw,rank) or LoadInteger(SpellCalcLast,raw,rank)!=StringHash(tip) or LoadInteger(SpellCalcLast,raw,rank+100)!=StringLength(tip) then
                    call BlzSetAbilityExtendedTooltip(raw,tip,rank-1+PriestTooltipOffset)
                    call SaveInteger(SpellCalcLast,raw,rank,StringHash(tip))
                    call SaveInteger(SpellCalcLast,raw,rank+100,StringLength(tip))
                endif
            endif
            set i=i+1
        endloop
    endif
    set hero=null
endfunction


function SpellCalc_Command takes nothing returns nothing
    local player viewer=GetTriggerPlayer()
    local string command=StringCase(GetEventPlayerChatString(),false)
    if command=="-spellcalculations off" then
        set SpellCalcHidden[GetPlayerId(viewer)]=true
        call DisplayTimedTextToPlayer(viewer,0,0,10,"Spell calculations hidden.")
    elseif command=="-spellcalculations on" then
        set SpellCalcHidden[GetPlayerId(viewer)]=false
        call DisplayTimedTextToPlayer(viewer,0,0,10,"Spell calculations shown.")
    else
        call DisplayTimedTextToPlayer(viewer,0,0,10,"Use -spellcalculations on or -spellcalculations off.")
    endif
    if GetLocalPlayer()==viewer then
        call SpellCalc_Update()
    endif
    set viewer=null
endfunction


function SpellCalc_Register takes nothing returns nothing
    local trigger command=CreateTrigger()
    local integer i=0
    loop
        exitwhen i>=8
        call TriggerRegisterPlayerChatEvent(command,Player(i),"-spellcalculations",false)
        set i=i+1
    endloop
    call TriggerAddAction(command,function SpellCalc_Command)
    set command=null
endfunction

function Priest_AbilityTalentTip takes unit hero,integer raw,integer row,integer choice returns nothing
    local integer rank=GetUnitAbilityLevel(hero,raw)
    if rank>0 then
        call BlzSetAbilityExtendedTooltip(raw,SpellCalc_Tooltip(hero,raw,rank),rank-1+PriestTooltipOffset)
    endif
endfunction


function Priest_RegenTooltip takes nothing returns nothing
    call SpellCalc_Update()
endfunction


function Priest_MasterEsuna takes nothing returns nothing
    if GetSpellAbilityId()=='A0W9' and Talent_Active(GetTriggerUnit(),12,2,2,'A0W9') then
        call Priest_Refresh(GetSpellTargetUnit())
    endif
endfunction


function Priest_MasterInit takes nothing returns nothing
    local trigger capture=CreateTrigger()
    local trigger rain=CreateTrigger()
    local trigger channel=CreateTrigger()
    local trigger esuna=CreateTrigger()
    local integer pid=0
    call Priest_MasterData()
    call SpellCalc_InitData()
    call SpellCalc_Register()
    set PriestRainTimer=CreateTimer()
    loop
        exitwhen pid>=8
        set PriestRainEnemies[pid]=CreateGroup()
        set pid=pid+1
    endloop
    call TriggerRegisterAnyUnitEventBJ(capture,EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddAction(capture,function Priest_RecordBuff)
    call TriggerRegisterAnyUnitEventBJ(rain,EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerRegisterAnyUnitEventBJ(rain,EVENT_PLAYER_UNIT_SPELL_ENDCAST)
    call TriggerRegisterAnyUnitEventBJ(rain,EVENT_PLAYER_UNIT_SPELL_FINISH)
    call TriggerAddAction(rain,function Priest_RainEvent)
    call TriggerRegisterAnyUnitEventBJ(channel,EVENT_PLAYER_UNIT_SPELL_CHANNEL)
    call TriggerAddAction(channel,function Priest_EsunaChannel)
    call TriggerRegisterAnyUnitEventBJ(esuna,EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddAction(esuna,function Priest_MasterEsuna)
    call TimerStart(CreateTimer(),1.,true,function Priest_RegenTooltip)
    set capture=null
    set rain=null
    set channel=null
    set esuna=null
endfunction

function Trig_Regen_Cast_IsRegen takes nothing returns boolean
    return(GetSpellAbilityId()=='A00L')or(GetSpellAbilityId()=='A0B6')or(GetSpellAbilityId()=='A1F4')or(GetSpellAbilityId()=='A0FW') // 'A00L': ability "Regen"; 'A0B6': ability "Regen"; 'A1F4': ability "Regen"; 'A0FW': ability "Regen"
endfunction

function Trig_Regen_Cast_Conditions takes nothing returns boolean
    return(Trig_Regen_Cast_IsRegen())
endfunction

function Trig_Regen_Cast_IsHero takes nothing returns boolean
    return(IsUnitType(GetTriggerUnit(),UNIT_TYPE_HERO))!=null
endfunction

function Trig_Regen_Cast_Actions takes nothing returns nothing
    local integer l_tempInteger
    local real l_tempReal
    set l_tempInteger=25
    if(Trig_Regen_Cast_IsHero())then
        // Add 1 point for each complete group of 3 Intelligence; leftover points do not count.
        set l_tempInteger=(l_tempInteger+(GetHeroStatBJ(bj_HEROSTAT_INT,GetTriggerUnit(),true)/ 3))
    else
        set l_tempInteger=(l_tempInteger+GetUnitLevel(GetTriggerUnit()))
    endif
    set l_tempReal=Prof_StaffPower(GetTriggerUnit())
    call SaveRealBJ((I2R(l_tempInteger)*l_tempReal),1,GetHandleIdBJ(GetSpellTargetUnit()),udg_HealOverTimeHash)
    call GroupAddUnitSimple(GetSpellTargetUnit(),udg_RegenGroup)
    call Priest_Swiftmend(GetTriggerUnit(),GetSpellTargetUnit(),GetSpellAbilityId())
endfunction

function Trig_Regen_Periodic_Conditions takes nothing returns boolean
    return(udg_InCinematicMode==false)and(IsUnitGroupEmptyBJ(udg_RegenGroup)==false)
endfunction

function Trig_Regen_Periodic_IsEnumHero takes nothing returns boolean
    return(IsUnitType(GetEnumUnit(),UNIT_TYPE_HERO))!=null
endfunction

function Trig_Regen_Periodic_IsHostileOwned takes nothing returns boolean
    return(GetOwningPlayer(GetEnumUnit())==Player($B)) // $B = 11
endfunction

function Trig_Regen_Periodic_HasNegateHeals takes nothing returns boolean
    return(GetUnitAbilityLevelSwapped('A0Z8',GetEnumUnit())>0) // 'A0Z8': ability "Negate Collateral Heals"
endfunction

function Trig_Regen_Periodic_HasRegenBuff takes nothing returns boolean
    return(UnitHasBuffBJ(GetEnumUnit(),'B006')) // 'B006': buff "Regen"
endfunction

function Trig_Regen_Periodic_LacksClarityBuff takes nothing returns boolean
    return(UnitHasBuffBJ(GetEnumUnit(),'B01A')==false) // 'B01A': buff tooltip "Mana Spring"
endfunction

function Trig_Regen_Periodic_HasStoredRegen takes nothing returns boolean
    return(LoadRealBJ(2,GetHandleIdBJ(GetEnumUnit()),udg_HealOverTimeHash)>.0)
endfunction

function Trig_Regen_Periodic_HasRegenAmount takes nothing returns boolean
    return(udg_TempReal>.0)
endfunction

function Trig_Regen_Periodic_LacksNegateHeals takes nothing returns boolean
    return(GetUnitAbilityLevelSwapped('A0Z8',GetEnumUnit())<=0) // 'A0Z8': ability "Negate Collateral Heals"
endfunction

function Trig_Regen_Periodic_IsAlreadyQueued takes nothing returns boolean
    return(IsUnitInGroup(GetEnumUnit(),udg_PendingEffectGroup))
endfunction

function Trig_Regen_Periodic_HasClarityBuff takes nothing returns boolean
    return(UnitHasBuffBJ(GetEnumUnit(),'B01A')) // 'B01A': buff tooltip "Mana Spring"
endfunction

function Trig_Regen_Periodic_IsNotPaused takes nothing returns boolean
    return(IsUnitPausedBJ(GetEnumUnit())==false)
endfunction

function Trig_Regen_Periodic_RegenUnit takes nothing returns nothing
    if(Trig_Regen_Periodic_IsNotPaused())then
        set udg_TempReal=.0
        if(Trig_Regen_Periodic_HasRegenBuff())then
            if(Trig_Regen_Periodic_HasNegateHeals())then
                call AddSpecialEffectTargetUnitBJ("overhead",GetEnumUnit(),"Abilities\\Spells\\Undead\\DeathPact\\DeathPactTarget.mdl")
                call DestroyEffectBJ(GetLastCreatedEffectBJ())
                call UnitRemoveBuffBJ('B006',GetEnumUnit()) // 'B006': buff "Regen"
            else
                set udg_TempReal=(udg_TempReal+LoadRealBJ(1,GetHandleIdBJ(GetEnumUnit()),udg_HealOverTimeHash))
                if(Trig_Regen_Periodic_IsEnumHero())then
                    // Heroes add one quarter of their Strength to this regeneration amount.
                    set udg_TempReal=(udg_TempReal+(I2R(GetHeroStatBJ(bj_HEROSTAT_STR,GetEnumUnit(),true))*.25))
                else
                    // Non-heroes add 2 points per unit level instead.
                    set udg_TempReal=(udg_TempReal+(I2R(GetUnitLevel(GetEnumUnit()))*2.))
                endif
                if LoadBoolean(udg_HealOverTimeHash,GetHandleId(GetEnumUnit()),10) then
                    set udg_TempReal=udg_TempReal*2.
                endif
                if(Trig_Regen_Periodic_IsHostileOwned())then
                    // For this hostile-owned unit, increase the current amount by 80%: 10 becomes 18.
                    set udg_TempReal=(udg_TempReal*1.8)
                endif
            endif
        endif
        if(Trig_Regen_Periodic_LacksNegateHeals())then
            if(Trig_Regen_Periodic_HasStoredRegen())then
                set udg_TempReal=((udg_TempReal+1)+LoadRealBJ(2,GetHandleIdBJ(GetEnumUnit()),udg_HealOverTimeHash))
                if(Trig_Regen_Periodic_LacksClarityBuff())then
                    set udg_DmgFlagManaDamage=true
                    set udg_IsPureDamage=true
                    set udg_DmgFlagPure=true
                    call UnitDamageTargetBJ(GetEnumUnit(),GetEnumUnit(),(LoadRealBJ(2,GetHandleIdBJ(GetEnumUnit()),udg_HealOverTimeHash)*(GetRandomReal(15.,16.)/ 64.)),ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
                endif
            endif
            if(Trig_Regen_Periodic_HasRegenAmount())then
                set udg_IsPureDamage=true
                set udg_DmgFlagPure=true
                call UnitDamageTargetBJ(GetEnumUnit(),GetEnumUnit(),(udg_TempReal*(GetRandomReal(15.,16.)/ 16.)),ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
            else
                call GroupAddUnitSimple(GetEnumUnit(),udg_PendingEffectGroup)
            endif
        else
            call GroupAddUnitSimple(GetEnumUnit(),udg_PendingEffectGroup)
        endif
        if(Trig_Regen_Periodic_HasClarityBuff())then
            set udg_IsPureDamage=true
            set udg_DmgFlagPure=true
            set udg_DmgFlagManaDamage=true
            if(Trig_Regen_Periodic_IsAlreadyQueued())then
                call UnitDamageTargetBJ(GetEnumUnit(),GetEnumUnit(),(GetUnitStateSwap(UNIT_STATE_MAX_MANA,GetEnumUnit())*.1),ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
                call GroupRemoveUnitSimple(GetEnumUnit(),udg_PendingEffectGroup)
            else
                // Result 1: (maximum mana of the unit being visited) times (0.1).
                // Result 2: (LoadRealBJ(2, GetHandleIdBJ(the unit being visited), udg_HealOverTimeHash)) plus (1).
                // Result 3: a random decimal number between 15 and 16.
                // Result 4: (result 3) divided by (64).
                // Result 5: (result 2) times (result 4).
                // Result 6: (result 1) plus (result 5).
                call UnitDamageTargetBJ(GetEnumUnit(),GetEnumUnit(),((GetUnitStateSwap(UNIT_STATE_MAX_MANA,GetEnumUnit())*.1)+((LoadRealBJ(2,GetHandleIdBJ(GetEnumUnit()),udg_HealOverTimeHash)+1)*(GetRandomReal(15.,16.)/ 64.))),ATTACK_TYPE_CHAOS,DAMAGE_TYPE_UNIVERSAL)
            endif
        endif
        call SaveRealBJ(-1.,2,GetHandleIdBJ(GetEnumUnit()),udg_HealOverTimeHash)
    endif
endfunction

function Trig_Regen_Periodic_Actions takes nothing returns nothing
    call GroupClear(udg_PendingEffectGroup)
    call ForGroupBJ(udg_RegenGroup,function Trig_Regen_Periodic_RegenUnit)
    call GroupRemoveGroup(udg_PendingEffectGroup,udg_RegenGroup)
    call GroupClear(udg_PendingEffectGroup)
endfunction

// World Editor calls InitTrig_Regen automatically; it is intentionally empty. This module's
// triggers are created by RegisterTriggers_Regen_Part1 / RegisterTriggers_Regen_Part2 (bottom of this module), which
// MapBootstrap's Startup_RegisterTriggers runs at the right point during startup.
function InitTrig_Regen takes nothing returns nothing
endfunction

function Register_Regen_Cast takes nothing returns nothing
    set gg_trg_Regen_Cast=CreateTrigger()
    call TriggerRegisterAnyUnitEventBJ(gg_trg_Regen_Cast,EVENT_PLAYER_UNIT_SPELL_EFFECT)
    call TriggerAddCondition(gg_trg_Regen_Cast,Condition(function Trig_Regen_Cast_Conditions))
    call TriggerAddAction(gg_trg_Regen_Cast,function Trig_Regen_Cast_Actions)
endfunction

function Register_Regen_Periodic takes nothing returns nothing
    set gg_trg_Regen_Periodic=CreateTrigger()
    call TriggerRegisterTimerEventPeriodic(gg_trg_Regen_Periodic,1.)
    call TriggerAddCondition(gg_trg_Regen_Periodic,Condition(function Trig_Regen_Periodic_Conditions))
    call TriggerAddAction(gg_trg_Regen_Periodic,function Trig_Regen_Periodic_Actions)
endfunction

// Creates part 1 of 2 of this module's triggers. Called once at startup from
// Startup_RegisterTriggers (MapBootstrap). The parts are registered at different points so that
// triggers sharing an event with other modules keep their original firing order.
function RegisterTriggers_Regen_Part1 takes nothing returns nothing
    call Register_Regen_Cast()
    call Priest_MasterInit()
endfunction

// Creates part 2 of 2 of this module's triggers. Called once at startup from
// Startup_RegisterTriggers (MapBootstrap). The parts are registered at different points so that
// triggers sharing an event with other modules keep their original firing order.
function RegisterTriggers_Regen_Part2 takes nothing returns nothing
    call Register_Regen_Periodic()
endfunction

endlibrary
