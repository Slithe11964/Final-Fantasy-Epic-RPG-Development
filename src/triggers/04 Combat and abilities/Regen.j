    call SaveStr(SpellCalcData,'A0VL',101,"|n|n|cffffcc00Damage details|r|nDamage per poison pulse: (133 + floor(INT / 2)) x Inner Mana spell power.|nInner Mana spell power = 1 + 100% x mana fraction x (1 + 10% x effective Inner Mana proficiency). Mind Charge doubles it; Concentration multiplies it by 1.5 at full mana. Pulse interval 0.5 seconds for 10 seconds.|nSTR/AGI/INT include bonuses. Mana fraction = current MP / maximum MP at cast time. Values are before damage bonuses, defenses and hit rolls; integer divisions round down.")
    call SaveInteger(SpellCalcData,'A0VL',-1,0)
