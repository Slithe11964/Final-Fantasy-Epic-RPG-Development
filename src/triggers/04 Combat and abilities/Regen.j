function SpellCalc_Data12 takes nothing returns nothing
    set SpellCalcRaw[86]='A11X'
    call SaveStr(SpellCalcData,'A11X',1,"|cffffcc00Life Spell|r|nChannels holy magic, healing all living allies nearby and damaging all enemies nearby regardless of their magic defense.")
    call SaveStr(SpellCalcData,'A11X',101,"|n|n|cffffcc00Damage details|r|nEnemy damage and allied healing: (400 + 2 x INT) x Staff spell power.|nStaff spell power = 1 + 50% x mana fraction x (1 + 10% x effective Staff proficiency). Mind Charge doubles it; Concentration multiplies it by 1.5 at full mana.|nSTR/AGI/INT include bonuses. Mana fraction = current MP / maximum MP at cast time. Values are before damage bonuses, defenses and hit rolls; integer divisions round down.")
    call SaveInteger(SpellCalcData,'A11X',-1,0)
    call SaveInteger(SpellCalcData,'A11X',-2,0)
    set SpellCalcRaw[87]='A12I'
    call SaveStr(SpellCalcData,'A12I',1,"Calls down waves of meteors that damage units in an area, dealing heavy non-elemental damage.")
    call SaveStr(SpellCalcData,'A12I',101,"|n|n|cffffcc00Damage details|r|nDamage per wave: (250 + floor(INT / 2)) x Inner Mana spell power.|nInner Mana spell power = 1 + 100% x mana fraction x (1 + 10% x effective Inner Mana proficiency). Mind Charge doubles it; Concentration multiplies it by 1.5 at full mana. 20 waves if all land.|nSTR/AGI/INT include bonuses. Mana fraction = current MP / maximum MP at cast time. Values are before damage bonuses, defenses and hit rolls; integer divisions round down.")
    call SaveInteger(SpellCalcData,'A12I',-1,0)
    call SaveInteger(SpellCalcData,'A12I',-2,0)
